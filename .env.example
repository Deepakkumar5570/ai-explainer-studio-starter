# Script generation (optional; demo mode works without it)
OPENAI_API_KEY=
SCRIPT_MODEL=gpt-4.1-mini

# Database / Supabase (configure before enabling persistence)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Queue / worker (configure before enabling asynchronous generation)
REDIS_URL=

# Object storage
ASSET_BUCKET=generated-assets
